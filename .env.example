# Never commit a real .env file to GitHub.
PINECONE_API_KEY=
PINECONE_INDEX=scholarlens
PINECONE_NAMESPACE=scholarship-docs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SCORE=0.25
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173
DATA_DIR=data
VITE_API_URL=

# Auth — generate a strong random secret for JWT_SECRET in production
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Google OAuth Client ID (from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
# Same Google Client ID for frontend
VITE_GOOGLE_CLIENT_ID=
